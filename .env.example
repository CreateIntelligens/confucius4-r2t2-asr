# 複製成 .env 再依這台機器調整：cp .env.example .env
# .env 不進版控；這裡列的是 compose.yaml 會讀的全部變數與預設值。

# 對外的埠（nginx）。API 容器本身不對外開埠。
PUBLIC_PORT=8803

# 推論後端：auto 依序嘗試 vllm → llama → transformers，哪個在這台起得來就用哪個。
# 也可以指定其中之一；指定的後端起不來時服務會回報錯誤，不會改用別的。
ASR_BACKEND=auto
# build 時是否編譯 llama.cpp 後端（1／0）。設 0 可省下 devel 映像與編譯時間，服務改用 transformers。
WITH_LLAMA=1

# 模型放在宿主的哪裡。目錄不存在會自動建立；是空的且 AUTO_DOWNLOAD=1 時自動下載
#（ASR 約 4 GB、GGUF 約 2.4 GB、VAD 約 2 MB）。
MODEL_HOST_DIR=./models/Confucius4-R2T2
VAD_HOST_DIR=./models/FireRedVAD
GGUF_HOST_DIR=./models/Confucius4-R2T2-GGUF
MODEL_ID=netease-youdao/Confucius4-R2T2
AUTO_DOWNLOAD=1
# 啟動後先跑一次推論暖機
AUTO_WARMUP=1

# 容器以這個宿主帳號執行，下載的模型檔才不會變成 root 的（id -u／id -g）
HOST_UID=1000
HOST_GID=1000

# 串流 header 沒帶 language 時的預設值。zhen 與 auto 都是逐句自動判斷語言（見 README）；
# 填 Chinese 等具體語言則固定用該語言解碼。
STREAM_DEFAULT_LANGUAGE=zhen
# 逐句自動判斷時信任的語言，逗號分隔；判出清單外的語言時改用第一個重辨識
STREAM_AUTO_LANGUAGES=Chinese,English,Japanese,Korean,Spanish
# 串流允許的 secret_key，逗號分隔
STREAM_SECRET_KEYS=test0102

# 同時進行的即時串流上限，超過就拒絕新連線（關閉碼 1013）
MAX_CONCURRENT_STREAMS=12

# 有人在講話時，上傳音檔最多每隔幾秒佔用一次推論（一次約一兩秒，期間字幕會頓一下）。
# 調大：字幕更順、上傳更慢；沒人講話時上傳不受這個限制。
UPLOAD_MIN_INTERVAL_SECONDS=5

# 只有 vLLM 後端會用到：佔用的顯存比例
GPU_MEMORY_UTILIZATION=0.35
